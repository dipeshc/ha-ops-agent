{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessments"
  ],
  "properties": {
    "assessments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "risk",
          "hold",
          "reason"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "maxLength": 140
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "hold": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          },
          "fix": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "why",
              "edits"
            ],
            "properties": {
              "why": {
                "type": "string",
                "maxLength": 600
              },
              "edits": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "old",
                    "new"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "old": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "new": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  }
                }
              }
            }
          },
          "urgent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quote",
              "affects"
            ],
            "properties": {
              "quote": {
                "type": "string",
                "maxLength": 300
              },
              "affects": {
                "type": "string",
                "maxLength": 300
              }
            }
          },
          "verdict": {
            "enum": [
              "not_affected",
              "fixable",
              "needs_owner",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "owner_action": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 160
              }
            ]
          }
        }
      }
    }
  }
}
